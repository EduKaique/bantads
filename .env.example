# Esse é o .env.example apenas um template do .env.
# Rode: cp .env.example .env
# Não commita alterações nesse arquivo, apenas faça alterações no .env

# -------------------------------------------------------
# CONFIGURAÇÃO DE E-MAIL
# Por padrão o projeto usa Mailpit (SMTP local, sem config).
# Acesse os e-mails em http://localhost:8025
# Para usar Gmail de verdade, preencha as variáveis abaixo
# e crie uma senha de app em: https://myaccount.google.com/apppasswords
# -------------------------------------------------------

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=seu_email_aqui
SPRING_MAIL_PASSWORD=sua_senha_de_app_aqui
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
