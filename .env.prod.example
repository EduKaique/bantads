# .env.prod.example — template para o ambiente de produção
# Copie para .env.prod e preencha os valores:
#   cp .env.prod.example .env.prod
# Não commite o arquivo .env.prod.

# -------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------
POSTGRES_USER=springuser
POSTGRES_PASSWORD=

# -------------------------------------------------------
# MongoDB (ms-auth)
# -------------------------------------------------------
MONGODB_URI=mongodb://mongodb-auth:27017/bantads_auth

# -------------------------------------------------------
# RabbitMQ
# -------------------------------------------------------
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=

# -------------------------------------------------------
# JWT — api-gateway (SECRET) e no ms-auth (APP_JWT_SECRET)
# -------------------------------------------------------
JWT_SECRET=

# -------------------------------------------------------
# E-mail 
# Para Gmail, crie uma senha de app em: https://myaccount.google.com/apppasswords
# -------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=seu_email@gmail.com
SPRING_MAIL_PASSWORD=sua_senha_de_app
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
